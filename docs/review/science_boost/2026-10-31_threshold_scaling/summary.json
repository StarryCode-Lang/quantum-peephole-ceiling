  "statement": "a library whose longest source pattern is L can only reach words of length <= L over g(n) generators; completeness at n qubits therefore forces sum_{k<=L} g^k >= |C_n|, i.e. L = Omega(n^2 / log n)",
  "formula": {
    "clifford_order": "2^(n^2+2n) * prod_{j=1..n} (4^j - 1)",
    "generators": "g(n) = 4n + n(n-1) = n^2 + 3n",
    "lower_bound": "L_min(n) = min{L : sum_{k<=L} g(n)^k >= |C_n|}",
    "asymptotic": "L_min(n) ~ 2 n^2 / log2(n^2 + 3n) = Omega(n^2 / log n)"
  },
